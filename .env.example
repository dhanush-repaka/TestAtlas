# TestAtlas settings. Copy this file to `.env` (same folder) and fill in what you need:
#
#     cp .env.example .env && chmod 600 .env
#
# `.env` is git-ignored and excluded from the Docker image -- never commit it.
# Anything already set in the real environment (shell, `docker run -e`, a platform's
# secrets) takes priority over this file.

# --- Access ---------------------------------------------------------------------------
# Login password for the whole app. Leave EMPTY only if it is reachable from your own
# machine alone. Set it for anything other than localhost (a shared server, a LAN).
TESTATLAS_PASSWORD=

# Optional: signs the login cookie. Defaults to the password; set your own long random
# string (e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`) so
# changing the password later doesn't depend on it.
TESTATLAS_SECRET=

# --- AI features (optional; the core graph, findings and insights work without) --------
# Powers plain-English module names, test-case generation and doc-vs-code gap analysis.
# NOTE: these send module/file/function names, on-screen text found in the code and your
# uploaded documents to the API below. No source-code bodies are sent.
OPENAI_API_KEY=

# Model for test-case generation (default gpt-4o-mini).
# OPENAI_TEST_MODEL=gpt-4o

# To use an OpenAI-compatible endpoint you control (an internal gateway or proxy)
# instead of api.openai.com:
# OPENAI_BASE_URL=https://your-gateway.example.com/v1

# --- Where data lives -------------------------------------------------------------------
# The SQLite database, run history, stored graphs, the encryption key for saved repo
# tokens, and cloned repositories. Default: inside this folder. Point it at a path that
# is backed up (and access-controlled) on your machine.
# DATA_ROOT=/var/lib/testatlas

# --- Serving ---------------------------------------------------------------------------
# Only when a reverse proxy serves TestAtlas under a sub-path, e.g. /testatlas.
# BASE_PATH=

# --- Optional Neo4j sync ---------------------------------------------------------------
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Note: Azure DevOps / GitHub access tokens are NOT set here. They are entered per repo in
# the app's UI and stored encrypted in DATA_ROOT.
